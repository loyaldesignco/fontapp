{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FontVault",
  "version": "0.1.0",
  "identifier": "design.loyal.fontvault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FontVault",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetScope": {
        "allow": ["**/*.ttf", "**/*.otf", "**/*.ttc", "**/*.otc"],
        "deny": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
